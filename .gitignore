# ==================================================
# ENTERPRISE .gitignore
# MERN + Next.js + TypeScript + Docker + MongoDB
# ==================================================

# =========================
# Operating System Files
# =========================
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini

# =========================
# Editors / IDEs
# =========================
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*.tmp

# =========================
# Logs
# =========================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# =========================
# Node Dependencies
# =========================
node_modules/
**/node_modules/
.npm/
.pnpm-store/
.yarn/
.yarn-cache/

# =========================
# Build / Output
# =========================
dist/
build/
out/
coverage/
.next/
.vercel/
.turbo/
.cache/
storybook-static/

# =========================
# TypeScript
# =========================
*.tsbuildinfo

# =========================
# Environment Variables
# =========================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*
!.env.example
!.env.sample
!.env.docker.example

# =========================
# Temporary Files
# =========================
tmp/
temp/
*.pid
*.seed
*.tgz

# =========================
# Uploads / User Files
# =========================
uploads/
public/uploads/
storage/

# =========================
# Databases / Local Data
# =========================
mongo_data/
mongodb-data/
*.sqlite
*.sqlite3
*.db

# =========================
# Docker
# =========================
docker-data/
.docker/
docker-compose.override.yml

# =========================
# Testing
# =========================
jest-cache/
playwright-report/
test-results/
coverage-final.json

# =========================
# Security / Certificates
# =========================
*.pem
*.key
*.crt
*.csr

# =========================
# Package Managers
# =========================
package-lock.json.bak
yarn.lock.bak
pnpm-lock.yaml.bak

# =========================
# Misc
# =========================
*.bak
*.orig
*.rej

# =========================
# Git History Rewrite Artifacts
# =========================
.git/refs/original/